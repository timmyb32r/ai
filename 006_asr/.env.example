# YouTube to SRT Service Configuration
# Copy this file to .env and adjust values.

ADDR=:8080
DEPLOY_MODE=local
ENGINE=sherpa-onnx
MODEL_PATH=/opt/models
ASR_MODEL=sense-voice-2024
LOG_LEVEL=info
TEMP_DIR=/tmp/yt2srt
CHUNK_DURATION=30
MAX_PARALLEL=4

# Yandex Cloud Object Storage (DEPLOY_MODE=ycloud only)
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
