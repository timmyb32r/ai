FROM python:3.11.13-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY services/requirements-asr.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY services/resident.py services/asr_backend.py ./
USER 65532:65532
CMD ["python", "resident.py"]

FROM runtime AS test
COPY services/test_resident.py services/test_real_asr.py ./
